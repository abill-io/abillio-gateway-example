# Abillio company API (staging sandbox). Production: the same path on the production host.
ABILLIO_API_URL=https://backend.abillio.dev/company-api/v1
# The key id shown on the API key page.
ABILLIO_API_KEY_ID=
# The 64 hex characters Abillio showed once when the key was created (the raw Ed25519 seed).
ABILLIO_PRIVATE_KEY=
# Only if the key reaches more than one account: the account UUID or slug to act as.
ABILLIO_ACCOUNT=
# Public https URL of this server, for webhooks (cloudflared/ngrok). Leave empty to poll instead.
PUBLIC_URL=
PORT=4000
