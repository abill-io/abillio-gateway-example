{
  "name": "abillio-gateway-example",
  "version": "0.1.8",
  "private": true,
  "description": "Clone-and-run sample of a company integrating Abillio: onboarding popup, invoice in the freelancer's name, wallet payment, payout, webhooks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env server.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env scripts/smoke.ts",
    "tunnel": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/tunnel.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
